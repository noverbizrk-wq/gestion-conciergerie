DATABASE_URL="postgresql://nover:nover@localhost:5433/gestion_conciergerie?schema=public"

# Généré avec : openssl rand -hex 32 (ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="remplace-moi-avec-un-secret-aleatoire"

# Clé de chiffrement des codes d'accès logement (AES-256). Même méthode de génération que AUTH_SECRET.
# Ne jamais la faire tourner sans plan de re-chiffrement des données existantes (les codes déjà stockés
# deviendraient illisibles si la clé change).
ACCESS_CODE_SECRET="remplace-moi-avec-un-secret-aleatoire"
