generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum VatRegime {
  REEL
  FRANCHISE
  INHERIT_COMPANY
}

enum Role {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
  READONLY
  SUPER_ADMIN
  OPERATIONAL_MANAGER
  AGENT
}

enum EmployeeType {
  SALARIE
  PRESTATAIRE
}

enum EmployeeDocumentType {
  CONTRAT
  ASSURANCE
  PIECE_IDENTITE
  CARTE_VITALE
  AUTRE
}

enum AccessCodeType {
  PORTE
  BOITE_A_CLES
  SERRURE_CONNECTEE
  PARKING
  WIFI
  AUTRE
}

enum MissionType {
  CLEANING
  QUALITY_CONTROL
  LAUNDRY
  MAINTENANCE
  CHECKIN_PREP
}

enum MissionStatus {
  TO_PLAN
  PLANNED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  DONE
  TO_REVIEW
  VALIDATED
  REFUSED
  CANCELLED
  LATE
}

enum MissionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MissionTaskCategory {
  CUISINE
  SALON
  CHAMBRES
  SALLE_DE_BAIN
  TOILETTES
  ENTREE
  TERRASSE
  LINGE
  CONSOMMABLES
  EQUIPEMENTS
  SECURITE
}

enum MissionPhotoPhase {
  BEFORE
  AFTER
}

enum PaymentMethod {
  VIREMENT
  CB
  ESPECES
  STRIPE
  GOCARDLESS
}

enum PropertyType {
  STUDIO
  T2
  T3
  T4_PLUS
  MAISON
  APPARTEMENT
}

enum CommissionMode {
  FIXED_PERCENT
  VARIABLE_TIERS
}

enum BilledTo {
  OWNER
  GUEST
}

enum BookingSource {
  AIRBNB
  BOOKING
  SMOOBU
  HOSTAWAY
  GUESTY
}

enum BookingStatus {
  IMPORTED
  INVOICED
  IGNORED
}

enum InvoiceType {
  COMMISSION
  CLEANING
  MIXED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  REFUNDED
}

enum QuotationStatus {
  PROPOSED
  EXPIRED
  REFUSED
  ACCEPTED
  INVOICED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum HourPackageStatus {
  ACTIVE
  CONSUMED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum DocumentType {
  CONTRAT
  RIB
  PIECE_IDENTITE
  AUTRE
}

// ─────────────────────────────────────────────
// CORE / MULTI-TENANT
// ─────────────────────────────────────────────

model Company {
  id               String    @id @default(cuid())
  name             String
  siret            String?
  tvaIntracom      String?
  address          String?
  iban             String?
  logoUrl          String?
  brandColor       String    @default("#0F172A")
  defaultVatRate   Decimal   @default(20) @db.Decimal(5, 2)
  defaultVatRegime VatRegime @default(REEL)
  invoiceCounter    Int       @default(0)
  quotationCounter  Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships   Membership[]
  owners        Owner[]
  properties    Property[]
  invoices      Invoice[]
  quotations    Quotation[]
  auditLogs     AuditLog[]
  bookings      Booking[]
  reviews       Review[]
  hourPackages  HourPackage[]
  employees     Employee[]

  @@map("companies")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  auditLogs    AuditLog[]
  employee     Employee?

  @@map("users")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("memberships")
}

// ─────────────────────────────────────────────
// OWNERS / PROPERTIES
// ─────────────────────────────────────────────

model Owner {
  id            String        @id @default(cuid())
  companyId     String
  firstName     String
  lastName      String
  companyName   String?
  siret         String?
  address       String?
  phone         String?
  email         String?
  vatRegime     VatRegime     @default(INHERIT_COMPANY)
  vatRate       Decimal?      @db.Decimal(5, 2)
  paymentMethod PaymentMethod @default(VIREMENT)
  iban          String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  properties   Property[]
  invoices     Invoice[]
  quotations   Quotation[]
  documents    Document[]
  hourPackages HourPackage[]

  @@index([companyId])
  @@map("owners")
}

model Property {
  id               String         @id @default(cuid())
  companyId        String
  ownerId          String
  name             String
  address          String
  city             String
  postalCode       String
  photos           String[]       @default([])
  type             PropertyType
  commissionMode   CommissionMode @default(FIXED_PERCENT)
  commissionRate   Decimal?       @db.Decimal(5, 2)
  commissionTiers  Json?
  vatRateOverride  Decimal?       @db.Decimal(5, 2)
  cleaningBilledTo BilledTo       @default(OWNER)
  cleaningFlatRate Decimal?       @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner         Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  cleaningTasks CleaningTask[]
  invoices      Invoice[]
  quotations    Quotation[]
  reviews       Review[]
  accessCodes   PropertyAccessCode[]
  missions      Mission[]

  @@index([companyId])
  @@index([ownerId])
  @@map("properties")
}

// ─────────────────────────────────────────────
// CODES D'ACCÈS LOGEMENT (chiffrés)
// ─────────────────────────────────────────────

model PropertyAccessCode {
  id           String         @id @default(cuid())
  propertyId   String
  type         AccessCodeType
  label        String?
  // Valeur chiffrée (AES-256-GCM, voir src/lib/crypto.ts) — jamais en clair en base.
  encryptedValue String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_access_codes")
}

model Document {
  id         String       @id @default(cuid())
  ownerId    String?
  type       DocumentType
  storagePath String
  uploadedAt DateTime     @default(now())

  owner Owner? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ─────────────────────────────────────────────
// BOOKINGS (IMPORT)
// ─────────────────────────────────────────────

model Booking {
  id                 String        @id @default(cuid())
  companyId          String
  propertyId         String
  source             BookingSource
  externalId         String
  checkIn            DateTime
  checkOut           DateTime
  grossAmount        Decimal       @db.Decimal(10, 2)
  netRent            Decimal       @db.Decimal(10, 2)
  cleaningFee        Decimal       @default(0) @db.Decimal(10, 2)
  touristTax         Decimal       @default(0) @db.Decimal(10, 2)
  platformCommission Decimal       @default(0) @db.Decimal(10, 2)
  rawImportPayload   Json?
  status             BookingStatus @default(IMPORTED)
  guestName          String?
  guestEmail         String?
  guestPhone         String?
  guestCount         Int?
  specialRequests    String?
  createdAt          DateTime      @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  missions Mission[]

  @@unique([propertyId, source, externalId])
  @@index([companyId])
  @@map("bookings")
}

// ─────────────────────────────────────────────
// CLEANING
// ─────────────────────────────────────────────

model CleaningTask {
  id             String   @id @default(cuid())
  companyId      String
  propertyId     String
  employeeId     String?
  date           DateTime
  durationMinutes Int
  price          Decimal  @db.Decimal(10, 2)
  billedTo       BilledTo @default(OWNER)
  photosBefore   String[] @default([])
  photosAfter    String[] @default([])
  comments       String?
  signatureUrl   String?
  invoiceLineId  String?  @unique
  createdAt      DateTime @default(now())

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLine? @relation(fields: [invoiceLineId], references: [id])

  @@index([companyId])
  @@map("cleaning_tasks")
}

// ─────────────────────────────────────────────
// INVOICING
// ─────────────────────────────────────────────

model Quotation {
  id          String          @id @default(cuid())
  companyId   String
  ownerId     String
  propertyId  String?
  number      String
  issueDate   DateTime        @default(now())
  validUntil  DateTime
  status      QuotationStatus @default(PROPOSED)
  subtotalHT  Decimal         @db.Decimal(10, 2)
  vatAmount   Decimal         @db.Decimal(10, 2)
  totalTTC    Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner    Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property Property?      @relation(fields: [propertyId], references: [id])
  lines    QuotationLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@map("quotations")
}

model QuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPriceHT Decimal @db.Decimal(10, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  lineTotalHT Decimal @db.Decimal(10, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_lines")
}

model Invoice {
  id           String        @id @default(cuid())
  companyId    String
  ownerId      String
  propertyId   String?
  type         InvoiceType
  number       String
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  status       InvoiceStatus @default(DRAFT)
  subtotalHT   Decimal       @db.Decimal(10, 2)
  vatAmount    Decimal       @db.Decimal(10, 2)
  totalTTC     Decimal       @db.Decimal(10, 2)
  pdfUrl       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner    Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property Property?     @relation(fields: [propertyId], references: [id])
  lines    InvoiceLine[]
  payments Payment[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([ownerId])
  @@map("invoices")
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPriceHT     Decimal  @db.Decimal(10, 2)
  vatRate         Decimal  @db.Decimal(5, 2)
  vatRateSource   String
  lineTotalHT     Decimal  @db.Decimal(10, 2)
  sourceBookingId String?

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cleaningTask CleaningTask?

  @@map("invoice_lines")
}

model Payment {
  id                     String        @id @default(cuid())
  invoiceId              String
  amount                 Decimal       @db.Decimal(10, 2)
  method                 PaymentMethod
  paidAt                 DateTime?
  status                 PaymentStatus @default(PENDING)
  stripePaymentIntentId  String?
  gocardlessPaymentId    String?
  createdAt              DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String
  diff       Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// AVIS CLIENTS
// ─────────────────────────────────────────────

model Review {
  id          String       @id @default(cuid())
  companyId   String
  propertyId  String
  bookingId   String?
  authorName  String?
  rating      Int
  comment     String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// PACKS D'HEURES PRÉPAYÉES
// ─────────────────────────────────────────────

model HourPackage {
  id            String            @id @default(cuid())
  companyId     String
  ownerId       String
  totalHours    Decimal           @db.Decimal(6, 2)
  usedHours     Decimal           @default(0) @db.Decimal(6, 2)
  pricePerHour  Decimal           @db.Decimal(10, 2)
  status        HourPackageStatus @default(ACTIVE)
  purchasedAt   DateTime          @default(now())
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   Owner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("hour_packages")
}


// ─────────────────────────────────────────────
// INTERVENANTS (EMPLOYÉS / PRESTATAIRES)
// ─────────────────────────────────────────────

model Employee {
  id              String       @id @default(cuid())
  companyId       String
  userId          String?      @unique
  firstName       String
  lastName        String
  email           String?
  phone           String?
  photoUrl        String?
  type            EmployeeType @default(SALARIE)
  skills          String[]     @default([])
  zone            String?
  hourlyRate      Decimal?     @db.Decimal(10, 2)
  perMissionRate  Decimal?     @db.Decimal(10, 2)
  active          Boolean      @default(true)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id])
  documents      EmployeeDocument[]
  availabilities EmployeeAvailability[]
  missions       Mission[]

  @@index([companyId])
  @@map("employees")
}

model EmployeeDocument {
  id         String               @id @default(cuid())
  employeeId String
  type       EmployeeDocumentType
  storagePath String
  expiresAt  DateTime?
  uploadedAt DateTime             @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

model EmployeeAvailability {
  id         String   @id @default(cuid())
  employeeId String
  weekday    Int // 0 = dimanche ... 6 = samedi
  startTime  String // "09:00"
  endTime    String // "18:00"

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_availabilities")
}


// ─────────────────────────────────────────────
// MISSIONS (MOTEUR D'AUTOMATISATION TERRAIN)
// ─────────────────────────────────────────────

model Mission {
  id                      String           @id @default(cuid())
  companyId               String
  propertyId              String
  bookingId               String?
  employeeId              String?
  type                    MissionType
  status                  MissionStatus    @default(TO_PLAN)
  priority                MissionPriority  @default(NORMAL)
  scheduledDate           DateTime
  startTime               String? // "11:00"
  dueTime                 String? // "15:00"
  estimatedDurationMinutes Int?
  instructions            String?
  photosRequired          Boolean          @default(true)
  comments                String?
  acceptedAt              DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  validatedAt             DateTime?
  createdAt               DateTime         @default(now())
  updatedAt                DateTime        @updatedAt

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking  Booking?     @relation(fields: [bookingId], references: [id])
  employee Employee?    @relation(fields: [employeeId], references: [id])
  tasks    MissionTask[]
  photos   MissionPhoto[]

  @@unique([bookingId, type])
  @@index([companyId])
  @@index([propertyId])
  @@index([employeeId])
  @@index([scheduledDate])
  @@map("missions")
}

model MissionTask {
  id              String              @id @default(cuid())
  missionId       String
  category        MissionTaskCategory
  label           String
  required        Boolean             @default(true)
  photoRequired   Boolean             @default(false)
  commentRequired Boolean             @default(false)
  done            Boolean             @default(false)
  comment         String?
  order           Int                 @default(0)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@map("mission_tasks")
}

model MissionPhoto {
  id          String            @id @default(cuid())
  missionId   String
  phase       MissionPhotoPhase
  room        String?
  storagePath String
  takenAt     DateTime          @default(now())

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@map("mission_photos")
}
